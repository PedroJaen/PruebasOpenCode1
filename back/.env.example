# Configuración del backend de PruebasOpenCode1.
# Copia este archivo a .env (ignorado por git) o define las variables en el
# entorno de ejecución. Nunca subas secretos reales al repositorio.

# Perfil activo: dev | test | pre | prod
SPRING_PROFILES_ACTIVE=dev

# Puerto HTTP
SERVER_PORT=8080

# Orígenes permitidos por CORS (uno o varios separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Credenciales del autologin transparente. En dev tienen valores de demo.
# En pre/prod son obligatorias y deben inyectarse desde el entorno.
APP_AUTH_USERNAME=demo
APP_AUTH_PASSWORD=demo1234
APP_AUTH_ROLE=USER

# Vigencia del token Bearer (formato Duration de Spring: 15m, 10m, 5m...).
APP_AUTH_TOKEN_TTL=15m

# Base de datos. En dev se usa un archivo H2 local.
DB_URL=jdbc:h2:file:./data/pruebasopencode1
DB_USERNAME=sa
DB_PASSWORD=
JPA_DDL_AUTO=update

# Consola H2 y Swagger: solo deben estar activas en desarrollo.
H2_CONSOLE_ENABLED=true
SPRINGDOC_ENABLED=true

# Nivel de log de la aplicación.
LOG_LEVEL=INFO
