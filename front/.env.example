# URL base de la API REST versionada.
# En desarrollo se puede dejar vacía: el cliente usará /api/v1 y el proxy de
# Vite enviará las peticiones a VITE_PROXY_TARGET.
# En un despliegue real, por ejemplo:
# VITE_API_BASE_URL=https://api.pre.pruebasopencode1.example.com/api/v1
VITE_API_BASE_URL=

# Destino del proxy del servidor de desarrollo de Vite.
VITE_PROXY_TARGET=http://localhost:8080

# Credenciales fijas del autologin transparente del frontend.
# Deben coincidir con APP_AUTH_USERNAME / APP_AUTH_PASSWORD del backend.
# Son valores visibles en el bundle: válidos para la demo local, no para
# producción. El token Bearer que devuelve el backend vive solo en memoria.
VITE_AUTH_USERNAME=demo
VITE_AUTH_PASSWORD=demo1234
