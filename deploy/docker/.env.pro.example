# Copia este fichero a .env.pro (ignorado por Git) y cambia los secretos.
# Se usa con: docker compose --env-file deploy/docker/.env.pro ...

ENTORNO=pro
SPRING_PROFILES_ACTIVE=prod

# Puertos publicados en el host para poder ejecutar PRE y PRO a la vez.
BACK_PORT=8091
FRONT_PORT=8098

# Base de datos H2 persistente dentro del contenedor.
DB_URL=jdbc:h2:file:/app/data/pruebasopencode1
DB_USERNAME=sa
DB_PASSWORD=cambia-esta-clave-pro
JPA_DDL_AUTO=update

# Mismo comportamiento que en local: datos mock, consola H2 y Swagger.
# Antes de una PRO real, desactiva la consola y Swagger y sustituye el autologin.
SEED_MOCK_DATA=true
H2_CONSOLE_ENABLED=true
H2_CONSOLE_ALLOW_OTHERS=true
SPRINGDOC_ENABLED=true

# Origen público del frontend de PRO.
CORS_ALLOWED_ORIGINS=http://localhost:8098,http://127.0.0.1:8098

# Credenciales del autologin. Deben coincidir con VITE_AUTH_*.
# En un despliegue real hay que sustituir el autologin por autenticación individual.
APP_AUTH_USERNAME=demo
APP_AUTH_PASSWORD=demo1234
APP_AUTH_ROLE=USER
APP_AUTH_TOKEN_TTL=5m

LOG_LEVEL=WARN

# Variables de compilación del frontend (se incrustan en el bundle).
VITE_API_BASE_URL=/api/v1
VITE_AUTH_USERNAME=demo
VITE_AUTH_PASSWORD=demo1234
