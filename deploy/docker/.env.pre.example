# Copia este fichero a .env.pre (ignorado por Git) y cambia los secretos.
# Se usa con: docker compose --env-file deploy/docker/.env.pre ...

ENTORNO=pre
SPRING_PROFILES_ACTIVE=pre

# Puertos publicados en el host para poder ejecutar PRE y PRO a la vez.
BACK_PORT=8081
FRONT_PORT=8088

# Base de datos H2 persistente dentro del contenedor.
DB_URL=jdbc:h2:file:/app/data/pruebasopencode1
DB_USERNAME=sa
DB_PASSWORD=cambia-esta-clave-pre
JPA_DDL_AUTO=update

# Mismo comportamiento que en local: datos mock, consola H2 y Swagger.
# Para un entorno expuesto, pon H2_CONSOLE_ENABLED=false y SPRINGDOC_ENABLED=false.
SEED_MOCK_DATA=true
H2_CONSOLE_ENABLED=true
H2_CONSOLE_ALLOW_OTHERS=true
SPRINGDOC_ENABLED=true

# Origen público del frontend de PRE.
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Credenciales del autologin. Deben coincidir con VITE_AUTH_*.
APP_AUTH_USERNAME=demo
APP_AUTH_PASSWORD=demo1234
APP_AUTH_ROLE=USER
APP_AUTH_TOKEN_TTL=10m

LOG_LEVEL=INFO

# Variables de compilación del frontend (se incrustan en el bundle).
VITE_API_BASE_URL=/api/v1
VITE_AUTH_USERNAME=demo
VITE_AUTH_PASSWORD=demo1234
